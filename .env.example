VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: NVIDIA Magpie TTS for dictation — get a free key at
# https://build.nvidia.com/nvidia/magpie-tts-multilingual
# When set, dictation uses high-quality neural TTS via the NVIDIA API
# instead of the browser's built-in SpeechSynthesis
VITE_NVIDIA_API_KEY=nvapi-...
